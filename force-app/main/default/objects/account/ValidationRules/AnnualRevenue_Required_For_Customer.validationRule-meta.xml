<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AnnualRevenue_Required_For_Customer</fullName>
    <active>true</active>
    <description>Annual Revenue is mandatory for Customer accounts.</description>
    <errorConditionFormula>
        AND(
            ISPICKVAL(Type, "Customer"),
            ISBLANK(AnnualRevenue)
        )
    </errorConditionFormula>
    <errorDisplayField>AnnualRevenue</errorDisplayField>
    <errorMessage>Please enter Annual Revenue for Customer Accounts.</errorMessage>
</ValidationRule>