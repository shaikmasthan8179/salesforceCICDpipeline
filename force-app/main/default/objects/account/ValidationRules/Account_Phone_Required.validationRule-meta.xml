<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Account_Phone_Required</fullName>
    <active>true</active>
    <description>Phone is mandatory when Type is Customer</description>
    <errorConditionFormula>
        AND(
            ISPICKVAL(Type, "Customer"),
            ISBLANK(Phone)
        )
    </errorConditionFormula>
    <errorDisplayField>Phone</errorDisplayField>
    <errorMessage>Phone Number is required for Customer accounts.</errorMessage>
</ValidationRule>